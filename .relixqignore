openbsd-compat/regress/Makefile
openbsd-compat/include
openssh.xml
opensshd.init
survey.sh
**/*.o
**/*.lo
**/*.so
**/*.dylib
**/*.dll
**/*.out
**/*.a
**/.*.swp
autom4te.cache/
scp
sftp
sftp-server
